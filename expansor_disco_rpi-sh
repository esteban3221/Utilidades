#!/bin/bash

# Verificar si se ejecuta como root
if [ "$EUID" -ne 0 ]; then
  echo "Por favor, ejecuta como root (sudo)"
  exit 1
fi

# 1. Detectar el dispositivo y partición raíz activa
ROOT_DEV=$(df / | tail -1 | awk '{print $1}')
# Soporta tanto /dev/mmcblk0p2 como /dev/sda2
if [[ "$ROOT_DEV" == *""pmc""* || "$ROOT_DEV" == *"nvme"* || "$ROOT_DEV" == *"mmcblk"* ]]; then
  ROOT_DISK=${ROOT_DEV%p*}
  PART_NUM=${ROOT_DEV##*p}
else
  ROOT_DISK=${ROOT_DEV%[0-9]*}
  PART_NUM=${ROOT_DEV##*[a-z]}
fi

PART_NAME=$(basename "$ROOT_DEV")

echo "=========================================="
echo "Disco detectado: $ROOT_DISK"
echo "Partición raíz:  $PART_NUM"
echo "=========================================="

# 2. Obtener el sector de inicio real directo desde Sysfs (Evita errores de traducción/columnas)
if [ -f "/sys/class/block/$PART_NAME/start" ]; then
  START_SECTOR=$(cat "/sys/class/block/$PART_NAME/start")
else
  echo "Error: No se pudo determinar el sector de inicio de la partición."
  exit 1
fi

echo "Sector de inicio detectado: $START_SECTOR"
echo "Redimensionando tabla de particiones..."

# 3. Automatizar fdisk con el nuevo flujo interactivo de Manjaro
# Flujo: d -> num -> n -> p -> num -> inicio -> fin(default) -> N(no borrar firma) -> w
fdisk "$ROOT_DISK" <<EOF
d
$PART_NUM
n
p
$PART_NUM
$START_SECTOR

N
w
EOF

echo "Informando al kernel sobre la nueva geometría..."
# Forzar al kernel a leer los cambios de la partición activa
partprobe "$ROOT_DISK" 2>/dev/null || partx -u "$ROOT_DEV" 2>/dev/null

echo "Redimensionando el sistema de archivos ext4..."
# Aplicar la expansión en caliente del sistema de archivos
if resize2fs "$ROOT_DEV"; then
  echo "=========================================="
  echo " ¡Expansión completada con éxito! "
  echo "=========================================="
else
  echo "------------------------------------------------------------------"
  echo "AVISO: El kernel requiere un reinicio para aplicar los cambios."
  echo "Por favor, ejecuta 'sudo reboot' y el espacio se asignará solo."
  echo "------------------------------------------------------------------"
fi
